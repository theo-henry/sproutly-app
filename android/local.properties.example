# Copy to local.properties (gitignored). Android Studio writes sdk.dir here on first sync.
sdk.dir=/Users/YOU/Library/Android/sdk

# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Demo account
DEMO_EMAIL=demo@sproutly.app
DEMO_PASSWORD=demo-password

# Optional map/search overrides. Defaults use MapLibre demo style + public Overpass.
# For production, use your own tile/style provider and preferably proxy/cache OSM search.
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
